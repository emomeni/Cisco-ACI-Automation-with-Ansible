# Export values in your shell; this file is not loaded automatically.
ACI_USERNAME=automation
# Password mode: inject ACI_PASSWORD from a secret manager (do not commit it).
# Certificate mode: set ACI_PRIVATE_KEY to an absolute private-key path and
# ACI_CERTIFICATE_NAME to the certificate name registered on the APIC user.
# Trust the APIC CA in the controller's OS trust store; TLS verification is mandatory.
